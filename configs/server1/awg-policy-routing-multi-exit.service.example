[Unit]
Description=Ordered policy routing for multiple VPN exits
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# Exit order after sorting Server2 by numeric priority.
ExecStart=/bin/sh -c '/usr/sbin/ip rule show | grep -Fq "iif <AWG_IF> lookup <LINUX_POLICY_TABLE_BASE>" || /usr/sbin/ip rule add priority 1000 iif <AWG_IF> lookup <LINUX_POLICY_TABLE_BASE>'
ExecStart=/bin/sh -c '/usr/sbin/ip rule show | grep -Fq "iif <AWG_IF> lookup <LINUX_POLICY_TABLE_BASE_PLUS_1>" || /usr/sbin/ip rule add priority 1001 iif <AWG_IF> lookup <LINUX_POLICY_TABLE_BASE_PLUS_1>'
ExecStart=/bin/sh -c '/usr/sbin/ip rule show | grep -Fq "iif <AWG_IF> lookup <LINUX_POLICY_TABLE_BASE_PLUS_2>" || /usr/sbin/ip rule add priority 1002 iif <AWG_IF> lookup <LINUX_POLICY_TABLE_BASE_PLUS_2>'

ExecStop=/bin/sh -c '/usr/sbin/ip rule del priority 1002 iif <AWG_IF> lookup <LINUX_POLICY_TABLE_BASE_PLUS_2> 2>/dev/null || true'
ExecStop=/bin/sh -c '/usr/sbin/ip rule del priority 1001 iif <AWG_IF> lookup <LINUX_POLICY_TABLE_BASE_PLUS_1> 2>/dev/null || true'
ExecStop=/bin/sh -c '/usr/sbin/ip rule del priority 1000 iif <AWG_IF> lookup <LINUX_POLICY_TABLE_BASE> 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
