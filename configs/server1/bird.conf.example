# BIRD 2.x example for Server1.
# All addresses are placeholders.

router id <WG_EXIT_S1_IP>;

ipv4 table exit4;
ipv4 table mt_advertised;

protocol device {
}

protocol bfd bfd_exit {
    interface "wg-exit" {
        interval 500 ms;
        idle tx interval 500 ms;
        multiplier 3;
    };

    interface "<AWG_IF>" {
        interval 500 ms;
        idle tx interval 500 ms;
        multiplier 3;
    };

    neighbor <WG_EXIT_S2_IP> dev "wg-exit" local <WG_EXIT_S1_IP>;
    neighbor <AWG_MIKROTIK_IP> dev "<AWG_IF>" local <AWG_SERVER_IP>;
}

protocol static exit_default {
    ipv4 {
        table exit4;
    };

    route 0.0.0.0/0 via <WG_EXIT_S2_IP> bfd;
}

protocol kernel kernel_exit {
    kernel table 200;

    ipv4 {
        table exit4;
        import none;
        export all;
    };
}

# This route is advertised to MikroTik, never installed in Server1's kernel.
# It remains independent of the BFD-controlled Server2 exit above.
protocol static mt_export {
    ipv4 { table mt_advertised; };
    route 0.0.0.0/0 reject;
}

protocol bgp bgp_mt {
    local <AWG_SERVER_IP> as <SERVER1_BGP_AS>;
    neighbor <AWG_MIKROTIK_IP> as <MT_BGP_AS>;
    interface "<AWG_IF>";
    bfd on;
    ipv4 {
        table mt_advertised;
        import none;
        export all;
        next hop self;
    };
}
